{
  "name": "@deepseek-ai/dsh-local-container-runtime",
  "description": "Rootless Podman Engine API owner for one disposable isolated execution world",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sandbox/local-container-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./workspaces": {
      "types": "./lib/types/workspaces.d.ts",
      "default": "./lib/workspaces.js"
    },
    "./workspace-types": {
      "types": "./lib/types/workspace-types.d.ts"
    },
    "./tool-request-repo-access": {
      "types": "./lib/types/tool-request-repo-access.d.ts",
      "default": "./lib/tool-request-repo-access.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "Containerfile",
    "lib/workspaces.js",
    "lib/types/**/*.d.ts",
    "lib/tool-request-repo-access.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@types/dockerode": "^4.0.1",
    "dockerode": "^5.0.1",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/node-addon-system": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^"
  }
}
