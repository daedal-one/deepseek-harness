{
  "name": "@deepseek-ai/dsh-artifacts-bundle",
  "description": "Opt-in durable Workspace artifact tools, authenticated API, and trusted Client viewer",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/artifacts"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-artifact-durable": "workspace:^",
    "@deepseek-ai/dsh-api-artifacts": "workspace:^",
    "@deepseek-ai/dsh-tool-artifact": "workspace:^",
    "@deepseek-ai/dsh-client-ui-artifacts": "workspace:^",
    "@deepseek-ai/dsh-artifact-runtime-podman": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
