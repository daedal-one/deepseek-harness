COPY renderer-lock.json /opt/artifact/package-lock.json
RUN npm ci --ignore-scripts --omit=optional --no-fund
COPY controller.mjs /opt/artifact/controller.mjs
USER pwuser
ENTRYPOINT ["node", "/opt/artifact/controller.mjs"]
